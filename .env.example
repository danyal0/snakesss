# Server
PORT=3001
NODE_ENV=production

# Persistent data (leaderboard + admin analytics). On Railway, mount a volume at /app/data.
DATA_DIR=/app/data

# Origins (comma-separated)
CLIENT_ORIGIN=https://your-app.railway.app
ADMIN_ORIGIN=https://your-admin.railway.app

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-to-a-secure-password

# AI (optional — falls back to rule-based if not set)
XAI_API_KEY=

# Railway auto-injects this:
# RAILWAY_STATIC_URL=https://your-app.railway.app
